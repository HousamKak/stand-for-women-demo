{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stand-for-women",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-27",
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/media/*"]},
  "r2_buckets": [{"binding": "MEDIA", "bucket_name": "stand-for-women-media"}],
  "ratelimits": [{"name": "CONTACT_RATE_LIMIT", "namespace_id": "1001", "simple": {"limit": 3, "period": 60}}],
  "vars": {
    "ALLOWED_ORIGINS": "https://standforwomen.org,https://www.standforwomen.org",
    "SUPABASE_URL": "",
    "SUPABASE_PUBLISHABLE_KEY": ""
  }
  // Set server secrets with wrangler secret put:
  // PREVIEW_SIGNING_SECRET (random, at least 32 characters)
  // SUPABASE_SERVICE_ROLE_KEY (for private inquiry insertion only)
  // Keep the R2 bucket private; do not enable r2.dev or a public bucket domain.
}
